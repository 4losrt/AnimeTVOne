<resources>

    <!-- Splash / system window theme for the TV app. The actual UI is driven by Compose (AnimetvoneTheme).
         Uses a platform theme (not Material Components) so the app does not need that library. -->
    <style name="Theme.Animetvone" parent="android:Theme.Material.NoActionBar">
        <!-- TV-friendly solid dark background so there is no flash before Compose draws -->
        <item name="android:windowBackground">@color/tv_background_solid</item>
        <item name="android:colorBackground">@color/tv_background_solid</item>
        <item name="android:statusBarColor">@color/tv_background_solid</item>
        <item name="android:navigationBarColor">@color/tv_background_solid</item>
    </style>
</resources>
